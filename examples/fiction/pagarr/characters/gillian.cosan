        proc    assess_pendant -> assess_chasers -> weigh_cost -> decide
        branch  chasers_outside == true  =>  ??  ! ??
                chasers_outside == false =>  ??  ! ??
                _                        =>  STOP:undefined_input
        Δ       ??
    }
}
